{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sockacademy/schemas/A1_output.schema.json",
  "version": "1.1.0",
  "title": "A1 Product Research — Output Schema",
  "description": "מבנה הנתונים שA1 כותב לGoogle Sheets (טאב: A1_Products). שמות השדות = שמות העמודות המדויקים ב-Google Sheets כפי שA2 קורא אותם.",
  "type": "object",
  "required": ["Product Name", "Source", "PID", "Rating", "Orders", "Reviews", "Supplier Price", "Retail Price", "Margin", "Margin Pct", "Image URL", "URL", "Materials", "Category", "Score"],
  "properties": {
    "Product Name": {
      "type": "string",
      "minLength": 5,
      "description": "שם המוצר המלא כפי שחזר מה-API"
    },
    "Source": {
      "type": "string",
      "enum": ["CJ", "AliExpress", "Alibaba"],
      "description": "פלטפורמה שממנה נמצא המוצר"
    },
    "PID": {
      "type": "string",
      "minLength": 1,
      "description": "מזהה מוצר ייחודי בפלטפורמת המקור"
    },
    "Rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "דירוג ממוצע (0 = לא זמין)"
    },
    "Orders": {
      "type": "integer",
      "minimum": 0,
      "description": "מספר הזמנות שנמכרו"
    },
    "Reviews": {
      "type": "integer",
      "minimum": 0,
      "description": "מספר ביקורות"
    },
    "Supplier Price": {
      "type": "number",
      "minimum": 0,
      "description": "מחיר ספק בדולרים (0 = לא זמין)"
    },
    "Retail Price": {
      "type": "number",
      "minimum": 0,
      "description": "מחיר קמעונאי מוצע (חישוב: Supplier Price × multiplier)"
    },
    "Margin": {
      "type": "number",
      "minimum": 0,
      "description": "רווח גולמי בדולרים (Retail Price - Supplier Price)"
    },
    "Margin Pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "אחוז מרג'ין"
    },
    "Image URL": {
      "type": "string",
      "description": "URL לתמונה ראשית (ריק אם לא זמין)"
    },
    "URL": {
      "type": "string",
      "minLength": 1,
      "description": "URL לדף המוצר בפלטפורמת המקור"
    },
    "Materials": {
      "type": "string",
      "description": "חומרים מופרדים בפסיקים (דוגמה: 'Merino Wool, Cashmere')"
    },
    "Category": {
      "type": "string",
      "enum": [
        "Premium Materials",
        "Athletic",
        "Dress & Formal",
        "Tactical & Outdoor",
        "Gift Sets",
        "Casual & No-Show",
        "General"
      ],
      "description": "קטגוריית סגנון — enum נוקשה, אסור ערכים חדשים ללא עדכון schema"
    },
    "Score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "ציון A1 (אלגוריתם ניקוד 120 נק' → normalized לـ100)"
    },
    "Score Reasons": {
      "type": "string",
      "description": "סיבות הניקוד — מופרדות בפסיקים (אופציונלי, לתצוגה בלבד)"
    },
    "Status": {
      "type": "string",
      "enum": ["", "Approved", "Rejected"],
      "description": "מוגדר ידנית על ידי גיא. A2 מעבד רק 'Approved'."
    },
    "Upload Status": {
      "type": "string",
      "pattern": "^($|uploading$|uploaded:[0-9]+$|error:.{1,200}$|stuck:[0-9]+$)",
      "description": "מוגדר על ידי A2/A0. ריק = טרם עובד. 'uploading' = בתהליך. 'uploaded:SHOPIFY_ID' = הושלם. 'error:...' = נכשל. 'stuck:TIMESTAMP' = נתקע — A0 מסמן ומתריע."
    },
    "Run Date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp של ריצת A1 שייצרה שורה זו"
    }
  },
  "additionalProperties": false
}
