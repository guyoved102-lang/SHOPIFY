{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sockacademy/schemas/A2_input.schema.json",
  "version": "1.1.0",
  "title": "A2 Product Upload — Input Schema",
  "description": "השדות שA2 קורא מ-A1_Products. חייב להיות subset מדויק של A1_output.schema.json. שמות השדות = שמות עמודות Google Sheets. אם A1 שינה שם שדה — יש לעדכן גם כאן.",
  "type": "object",
  "required": ["Product Name", "Category", "Supplier Price", "Retail Price", "Image URL", "URL", "PID", "Source"],
  "properties": {
    "Product Name": {
      "$ref": "A1_output.schema.json#/properties/Product Name"
    },
    "Source": {
      "$ref": "A1_output.schema.json#/properties/Source"
    },
    "PID": {
      "$ref": "A1_output.schema.json#/properties/PID"
    },
    "Category": {
      "$ref": "A1_output.schema.json#/properties/Category"
    },
    "Materials": {
      "$ref": "A1_output.schema.json#/properties/Materials"
    },
    "Retail Price": {
      "$ref": "A1_output.schema.json#/properties/Retail Price"
    },
    "Supplier Price": {
      "$ref": "A1_output.schema.json#/properties/Supplier Price"
    },
    "Image URL": {
      "$ref": "A1_output.schema.json#/properties/Image URL"
    },
    "URL": {
      "$ref": "A1_output.schema.json#/properties/URL"
    },
    "Status": {
      "$ref": "A1_output.schema.json#/properties/Status"
    },
    "Upload Status": {
      "$ref": "A1_output.schema.json#/properties/Upload Status"
    }
  },
  "notes": {
    "filter_condition": "Status === 'Approved' AND 'Upload Status' is empty string",
    "idempotency_guard": "A2 writes 'uploading' to 'Upload Status' BEFORE creating Shopify product. See IDEMPOTENCY.md"
  }
}
