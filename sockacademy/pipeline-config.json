{
  "_meta": {
    "version": "3.0.0",
    "last_updated": "2026-06-24",
    "owner": "A0 Orchestrator",
    "description": "Declarative dependency graph + trigger matrix for all 28 SockAcademy agents. A0 reads this file — no hardcoded logic in A0 agent.js.",
    "data_layer": {
      "supabase_migrated_primary": ["A0", "A1", "A2", "A10", "A11", "A13"],
      "supabase_health_log": ["A0", "A1", "A2", "A2.5", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10", "A11", "A12", "A13", "A14", "A15", "A16", "A17", "A19", "A20", "A22", "A23"],
      "google_sheets_legacy": ["A7"],
      "supabase_tables": {
        "products":           "A1 write (research) + A2 write (upload) — primary product table",
        "trends":             "A10 output — trend intelligence",
        "competitor_prices":  "A11 output — pricing data",
        "competitor_intel":   "A13 output — competitive landscape",
        "agent_health_log":   "A0 state ledger",
        "pending_approvals":  "HitL approval queue (Phase B)",
        "queue_log":          "Upstash event audit trail"
      }
    },
    "observability": {
      "provider": "LangFuse",
      "module":   "sockacademy/corp/core/observability.js",
      "secrets":  ["LANGFUSE_PUBLIC_KEY", "LANGFUSE_SECRET_KEY"],
      "note":     "graceful no-op when secrets absent"
    },
    "event_queue": {
      "provider": "Upstash Redis",
      "module":   "sockacademy/corp/core/queue.js",
      "secrets":  ["UPSTASH_REDIS_REST_URL", "UPSTASH_REDIS_REST_TOKEN"],
      "queues":   ["sa:queue:upload", "sa:queue:content", "sa:queue:orders", "sa:queue:stock", "sa:queue:intel"]
    },
    "webhook_bridge": {
      "provider":  "Make.com → GitHub repository_dispatch",
      "workflow":  ".github/workflows/shopify-webhook-handler.yml",
      "topics":    ["orders/create", "orders/paid", "inventory_levels/update", "products/create", "products/update"],
      "secret":    "MAKE_WEBHOOK_URL (in .env — for register_webhooks.js setup)"
    },
    "guardrails": {
      "structure_lint":   ".github/workflows/structure-lint.yml — runs on every push, fails CI in ~15s on violations",
      "a0_health_check":  "A0 agent step 3 — workspace structure check on every daily run, email alert on violation",
      "creation_protocol": "CLAUDE.md FILE CREATION PROTOCOL — 3 mandatory questions before any new file"
    },
    "token_refresh": {
      "agent":    "A17",
      "schedule": "1st of every 2nd month, 08:00 UTC",
      "workflow": ".github/workflows/a17-token-refresher.yml",
      "secrets":  ["META_APP_ID", "META_APP_SECRET", "GH_PAT_SECRETS_WRITE"]
    }
  },

  "concurrency_limit": 6,
  "_concurrency_note": "GitHub Free plan: 20 concurrent jobs. Each agent = ~2 jobs (checkout + run). 6 agents × 2 = 12 jobs — leaves 8 buffer for manual triggers.",

  "pipelines": [

    {
      "id": "product-pipeline",
      "name": "Product Discovery → Upload",
      "trigger": {
        "type": "cron",
        "schedule": "0 7 * * 1",
        "description": "כל יום שני 07:00 UTC (10:00 ישראל)"
      },
      "chain": [
        {
          "agent": "A1",
          "workflow": "a1-product-research.yml",
          "timeout_minutes": 30,
          "data_output": {
            "via": "google_sheets",
            "tab": "A1_Products",
            "schema": "schemas/A1_output.schema.json"
          },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "stateless — always safe to retry"
        },
        {
          "agent": "A2",
          "workflow": "a2-product-upload.yml",
          "timeout_minutes": 20,
          "depends_on": "A1",
          "wait_for_human": {
            "description": "גיא חייב לסמן לפחות מוצר אחד כ-'Approved' ב-Google Sheet לפני שA2 רץ",
            "field": "Status",
            "value": "Approved",
            "tab": "A1_Products"
          },
          "data_input": {
            "via": "google_sheets",
            "tab": "A1_Products",
            "filter": "Status=Approved AND 'Upload Status'=''",
            "schema": "schemas/A2_input.schema.json"
          },
          "data_output": {
            "via": "google_sheets",
            "tab": "A1_Products",
            "writes_back": "Upload Status",
            "schema": "schemas/A2_output.schema.json"
          },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "optimistic_lock — writes 'uploading' to Sheets before Shopify call. See schemas/IDEMPOTENCY.md"
        }
      ]
    },

    {
      "id": "intelligence-cluster",
      "name": "Weekly Market Intelligence",
      "trigger": {
        "type": "cron",
        "schedule": "0 5 * * 0",
        "description": "כל יום ראשון 05:00 UTC (08:00 ישראל)"
      },
      "parallel": [
        {
          "agent": "A10",
          "workflow": "a10-trend-scout.yml",
          "timeout_minutes": 20,
          "data_output": {
            "via": "supabase",
            "table": "trends",
            "also": "email_to_admin"
          },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "stateless — safe to retry"
        },
        {
          "agent": "A11",
          "workflow": "a11-price-intelligence.yml",
          "timeout_minutes": 20,
          "note": "Replace cheerio with Perplexity API — pending PERPLEXITY_API_KEY secret",
          "data_output": {
            "via": "supabase",
            "table": "competitor_prices",
            "also": "email_to_admin"
          },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "stateless — safe to retry"
        },
        {
          "agent": "A13",
          "workflow": "a13-competitive-intel.yml",
          "timeout_minutes": 30,
          "data_output": {
            "via": "supabase",
            "table": "competitor_intel"
          },
          "retry": { "max_attempts": 2, "backoff_minutes": 10 },
          "idempotency": "stateless — appends rows, safe to retry"
        }
      ]
    },

    {
      "id": "post-purchase-cluster",
      "name": "Daily Post-Purchase",
      "trigger": {
        "type": "cron",
        "schedule": "0 7 * * *",
        "description": "כל יום 07:00 UTC (10:00 ישראל)"
      },
      "parallel": [
        {
          "agent": "A12",
          "workflow": "a12-review-collector.yml",
          "timeout_minutes": 15,
          "data_output": { "via": "email_to_admin", "schema": null },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "shopify_tag — tag 'review-requested' prevents duplicate sends. Safe to retry."
        }
      ]
    },

    {
      "id": "content-cluster",
      "name": "Weekly Content",
      "trigger": {
        "type": "cron",
        "schedule": "0 8 * * 2",
        "description": "כל יום שלישי 08:00 UTC (11:00 ישראל)"
      },
      "parallel": [
        {
          "agent": "A3",
          "workflow": "a3-content.yml",
          "timeout_minutes": 20,
          "data_output": { "via": "shopify_blog_post", "schema": null },
          "retry": { "max_attempts": 1, "backoff_minutes": 10 },
          "idempotency": "check_existing — A3 should check if article with same title exists before creating"
        },
        {
          "agent": "A4",
          "workflow": "a4-meta-ads.yml",
          "timeout_minutes": 15,
          "data_output": { "via": "google_sheets_or_email", "schema": null },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "stateless — generates copy, does not publish"
        },
        {
          "agent": "A5",
          "workflow": "a5-social.yml",
          "timeout_minutes": 20,
          "data_output": { "via": "google_drive", "schema": null },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "stateless — generates assets, does not post"
        }
      ]
    },

    {
      "id": "ops-cluster",
      "name": "Operational Monitoring",
      "trigger": {
        "type": "cron",
        "schedule": "0 6 * * 3",
        "description": "כל יום רביעי 06:00 UTC (09:00 ישראל)"
      },
      "parallel": [
        {
          "agent": "A7",
          "workflow": "a7-supplier-monitor.yml",
          "timeout_minutes": 20,
          "note": "Blocked on real product data — currently uses MOCK_PRODUCTS. See schemas/A7_input.schema.json migration_note.",
          "data_input": {
            "via": "google_sheets",
            "tab": "A1_Products",
            "filter": "UploadStatus starts with 'uploaded:'",
            "schema": "schemas/A7_input.schema.json"
          },
          "retry": { "max_attempts": 2, "backoff_minutes": 5 },
          "idempotency": "shopify_price_update — idempotent by design (same price = no-op)"
        },
        {
          "agent": "A9",
          "workflow": "a9-legal-compliance.yml",
          "timeout_minutes": 15,
          "data_output": { "via": "email_to_admin", "schema": null },
          "retry": { "max_attempts": 1, "backoff_minutes": 10 },
          "idempotency": "stateless — generates report only"
        }
      ]
    }
  ],

  "one_time_agents": [
    {
      "agent": "A6",
      "workflow": "a6-email-sync.yml",
      "description": "הגדרת Klaviyo templates — מריץ פעם אחת לפני השקה, ואחרי כל שינוי בתוכן המייל",
      "trigger": "manual_only",
      "idempotency": "upsert_by_name — בודק אם template קיים לפי שם לפני יצירה. Safe to re-run."
    }
  ],

  "future_agents": {
    "already_built": {
      "sa7_c_suite":    ["A8_Analytics", "A14_COO", "A15_CFO", "A16_CX"],
      "sa8_supply_chain": ["A17_TokenRefresher", "A19_Returns", "A20_Inventory", "A22_SupplyChain", "A23_FactoryRelations"],
      "status": "BUILT — commits 70f31a3 (SA-7) + 4a81060 (SA-8). Awaiting LAUNCH_MODE=true to activate."
    },
    "pending_phase_3": {
      "risk": ["A18_Fraud", "A21_Affiliate"],
      "growth": ["A24_CRO", "A25_Influencer", "A26_Regulatory", "A27_PR", "A28_SubscriptionClub"],
      "status": "NOT YET BUILT — Phase 3 trigger: $5K MRR × 2 consecutive months"
    }
  },

  "state_ledger": {
    "location": "supabase",
    "table": "agent_health_log",
    "columns": ["id", "agent_id", "agent_name", "run_status", "gh_run_id", "gh_run_url", "duration_ms", "items_processed", "error_message", "error_code", "metadata", "created_at"],
    "run_status_values": ["success", "failure", "warning", "skipped"],
    "append_only": true,
    "setup_note": "Table exists in Supabase with RLS ON. Schema fixed 22/06/2026 — corp/core/agent_health_log.sql is source of truth."
  },

  "stuck_detection": {
    "description": "A0 detects rows in A1_Products where 'Upload Status' = 'uploading' past the agent timeout. Marks them stuck:TIMESTAMP and alerts Guy.",
    "trigger": "Runs after every A2 completion OR after A2 timeout event",
    "algorithm": [
      "1. Query A1_Products for all rows where 'Upload Status' = 'uploading'",
      "2. For each such row: compare current_time against A0_STATE_LEDGER.LastRun for A2",
      "3. If (current_time - LastRun) > stuck_threshold_minutes → mark row 'Upload Status' = 'stuck:UNIX_TIMESTAMP'",
      "4. Send alert email to admin listing all newly-stuck rows (name, PID, time stuck)"
    ],
    "stuck_threshold_minutes": 30,
    "stuck_status_pattern": "^stuck:[0-9]+$",
    "alert_via": "email_to_admin",
    "recovery": "Guy manually clears 'Upload Status' to '' to allow retry, or to 'error:manual-skip' to permanently skip",
    "implementation_phase": "Phase B — A0 MVP",
    "design_status": "FINAL — ready to code when Phase B begins"
  }
}
