{%- style -%}
  #BlogPreview-{{ section.id }} {
    background-color: var(--surface-base);
    padding: 6.25rem 2rem;
    font-family: 'DM Sans', sans-serif;
  }

  /* ── Header ── */
  #BlogPreview-{{ section.id }} .bp__header {
    text-align: center;
    margin-bottom: 60px;
  }

  #BlogPreview-{{ section.id }} .bp__label {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 18px;
  }

  #BlogPreview-{{ section.id }} .bp__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--cream);
    margin: 0 0 16px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  #BlogPreview-{{ section.id }} .bp__title-rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 20px;
  }

  #BlogPreview-{{ section.id }} .bp__title-rule::before,
  #BlogPreview-{{ section.id }} .bp__title-rule::after {
    content: '';
    display: block;
    width: 48px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  #BlogPreview-{{ section.id }} .bp__title-rule-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
  }

  /* ── Grid ── */
  #BlogPreview-{{ section.id }} .bp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 1160px;
    margin: 0 auto 56px;
  }

  /* ── Card ── */
  #BlogPreview-{{ section.id }} .bp__card {
    background: var(--surface-void);
    border: 1px solid var(--surface-border);
    padding: 36px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: border-color 0.3s ease, transform 0.3s ease;
    position: relative;
  }

  #BlogPreview-{{ section.id }} .bp__card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cream);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #BlogPreview-{{ section.id }} .bp__card:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
  }

  #BlogPreview-{{ section.id }} .bp__card:hover::before {
    opacity: 1;
  }

  #BlogPreview-{{ section.id }} .bp__card-category {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }

  #BlogPreview-{{ section.id }} .bp__card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--cream);
    line-height: 1.35;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  #BlogPreview-{{ section.id }} .bp__card-excerpt {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.75;
    margin: 0 0 24px;
  }

  #BlogPreview-{{ section.id }} .bp__card-divider {
    width: 28px;
    height: 1px;
    background: var(--surface-border);
    margin-bottom: 24px;
    transition: background 0.3s ease, width 0.3s ease;
  }

  #BlogPreview-{{ section.id }} .bp__card:hover .bp__card-divider {
    background: var(--cream);
    width: 40px;
  }

  #BlogPreview-{{ section.id }} .bp__card-link {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--cream);
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.2s ease;
    margin-top: auto;
  }

  #BlogPreview-{{ section.id }} .bp__card-link:hover {
    gap: 10px;
  }

  /* ── CTA ── */
  #BlogPreview-{{ section.id }} .bp__cta {
    text-align: center;
  }

  #BlogPreview-{{ section.id }} .bp__cta-btn {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    border: 1px solid var(--gold);
    background: transparent;
    padding: 16px 40px;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #BlogPreview-{{ section.id }} .bp__cta-btn:hover {
    background: var(--gold);
    color: var(--surface-base);
  }

  /* ── Responsive ── */
  @media screen and (max-width: 899px) {
    #BlogPreview-{{ section.id }} .bp__grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    #BlogPreview-{{ section.id }} {
      padding: 2.5rem 1.25rem;
    }

    #BlogPreview-{{ section.id }} .bp__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #BlogPreview-{{ section.id }} .bp__header {
      margin-bottom: 2rem;
    }

    #BlogPreview-{{ section.id }} .bp__card {
      padding: 1.5rem 1.25rem;
    }

    #BlogPreview-{{ section.id }} .bp__card-title {
      font-size: 1.1rem;
    }
  }
{%- endstyle -%}

<section id="BlogPreview-{{ section.id }}">

  <div class="bp__header">
    <span class="bp__label">{{ section.settings.label }}</span>
    <h2 class="bp__title">{{ section.settings.title }}</h2>
    <div class="bp__title-rule" aria-hidden="true">
      <span class="bp__title-rule-dot"></span>
    </div>
  </div>

  <div class="bp__grid">

    <article class="bp__card">
      <p class="bp__card-category">{{ section.settings.card_1_category }}</p>
      <h3 class="bp__card-title">{{ section.settings.card_1_title }}</h3>
      <p class="bp__card-excerpt">{{ section.settings.card_1_excerpt }}</p>
      <div class="bp__card-divider"></div>
      {%- if section.settings.card_1_link != blank -%}
        <a class="bp__card-link" href="{{ section.settings.card_1_link }}">
          Read More <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </article>

    <article class="bp__card">
      <p class="bp__card-category">{{ section.settings.card_2_category }}</p>
      <h3 class="bp__card-title">{{ section.settings.card_2_title }}</h3>
      <p class="bp__card-excerpt">{{ section.settings.card_2_excerpt }}</p>
      <div class="bp__card-divider"></div>
      {%- if section.settings.card_2_link != blank -%}
        <a class="bp__card-link" href="{{ section.settings.card_2_link }}">
          Read More <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </article>

    <article class="bp__card">
      <p class="bp__card-category">{{ section.settings.card_3_category }}</p>
      <h3 class="bp__card-title">{{ section.settings.card_3_title }}</h3>
      <p class="bp__card-excerpt">{{ section.settings.card_3_excerpt }}</p>
      <div class="bp__card-divider"></div>
      {%- if section.settings.card_3_link != blank -%}
        <a class="bp__card-link" href="{{ section.settings.card_3_link }}">
          Read More <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </article>

  </div>

  <div class="bp__cta">
    <a class="bp__cta-btn" href="{{ section.settings.cta_link }}">
      {{ section.settings.cta_label }}
    </a>
  </div>

</section>

{% schema %}
{
  "name": "Blog Preview",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "From The Academy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Sock Knowledge"
    },
    {
      "type": "header",
      "content": "Article 1"
    },
    {
      "type": "text",
      "id": "card_1_category",
      "label": "Category",
      "default": "Materials"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Title",
      "default": "The Complete Guide to Merino Wool Socks"
    },
    {
      "type": "textarea",
      "id": "card_1_excerpt",
      "label": "Excerpt",
      "default": "Merino wool isn't just for cold weather. It is the most versatile sock material on the planet — knowing its weight is knowing your fit."
    },
    {
      "type": "url",
      "id": "card_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Article 2"
    },
    {
      "type": "text",
      "id": "card_2_category",
      "label": "Category",
      "default": "Style Guide"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Title",
      "default": "How to Choose Socks for Every Occasion"
    },
    {
      "type": "textarea",
      "id": "card_2_excerpt",
      "label": "Excerpt",
      "default": "From boardroom to trail, the right sock changes everything. Our definitive guide to matching sock type, height, and material to every situation."
    },
    {
      "type": "url",
      "id": "card_2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Article 3"
    },
    {
      "type": "text",
      "id": "card_3_category",
      "label": "Category",
      "default": "Philosophy"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Title",
      "default": "Why Your Socks Matter More Than You Think"
    },
    {
      "type": "textarea",
      "id": "card_3_excerpt",
      "label": "Excerpt",
      "default": "The one garment closest to the ground, worn every day, touched by nothing. We make the case for why the humble sock deserves your full attention."
    },
    {
      "type": "url",
      "id": "card_3_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Visit The Academy →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Blog Preview"
    }
  ]
}
{% endschema %}
