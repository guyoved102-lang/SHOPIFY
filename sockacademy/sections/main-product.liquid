<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  /* ━━━ PRODUCT PAGE — Precision Mode ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     All values reference Phase 1 tokens from sockacademy.css :root.
     Zero hardcoded hex values. Gold count (max 3):
       #1 — ATC button fill (primary CTA)
       #2 — Material Insight authority block (cert badge + label)
       #3 — Active variant/thumb accent (structural, functional)
     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

  #MainProduct-{{ section.id }} {
    background: var(--surface-base);
    padding: var(--space-6) var(--space-3) 0;
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
  }

  #MainProduct-{{ section.id }} .sp__inner {
    max-width: var(--width-content);
    margin: 0 auto;
  }

  /* ── Breadcrumb ─────────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__breadcrumb {
    font-size: var(--text-xs);
    color: var(--ghost);
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  #MainProduct-{{ section.id }} .sp__breadcrumb a {
    color: var(--ghost);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-luxury);
  }

  #MainProduct-{{ section.id }} .sp__breadcrumb a:hover { color: var(--cream); }
  #MainProduct-{{ section.id }} .sp__breadcrumb span   { color: var(--muted); }

  /* ── Two-column layout ──────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__layout {
    display: grid;
    grid-template-columns: 55% 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  /* ─────────────────────────────────────────────────────────────────
     GALLERY
  ───────────────────────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__gallery {
    position: sticky;
    top: var(--space-3);
  }

  #MainProduct-{{ section.id }} .sp__main-img-wrap {
    background: var(--surface-raised);
    border: 1px solid var(--surface-border);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
  }

  #MainProduct-{{ section.id }} .sp__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-micro) var(--ease-luxury);
    display: block;
  }

  #MainProduct-{{ section.id }} .sp__main-img.sp--swapping {
    opacity: 0;
  }

  #MainProduct-{{ section.id }} .sp__thumbs {
    display: flex;
    gap: var(--space-1);
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }

  #MainProduct-{{ section.id }} .sp__thumb {
    width: 64px;
    height: 80px;
    background: var(--surface-raised);
    border: 1.5px solid var(--surface-border);
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: border-color var(--duration-micro) var(--ease-luxury);
    flex-shrink: 0;
  }

  #MainProduct-{{ section.id }} .sp__thumb:hover,
  #MainProduct-{{ section.id }} .sp__thumb--active {
    border-color: var(--gold);
  }

  #MainProduct-{{ section.id }} .sp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─────────────────────────────────────────────────────────────────
     PRODUCT INFO
  ───────────────────────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__info {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #MainProduct-{{ section.id }} .sp__vendor {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-1);
  }

  #MainProduct-{{ section.id }} .sp__title {
    font-family: 'Playfair Display', serif;
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    color: var(--cream);
    text-transform: uppercase;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3);
  }

  /* ── Price ─────────────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  #MainProduct-{{ section.id }} .sp__price {
    font-family: 'Playfair Display', serif;
    font-size: var(--text-xl);
    letter-spacing: 0.04em;
    color: var(--cream);
    line-height: var(--leading-tight);
    font-weight: var(--weight-regular);
  }

  #MainProduct-{{ section.id }} .sp__compare-price {
    font-size: var(--text-sm);
    color: var(--ghost);
    text-decoration: line-through;
  }

  #MainProduct-{{ section.id }} .sp__badge-sale {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--surface-void);
    background: var(--gold);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  /* ── Short description ─────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__short-desc {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3);
    border-left: 2px solid var(--surface-border);
    padding-left: var(--space-2);
  }

  /* ── Material Insight — authority card (in-column) ─────────────── */
  #MainProduct-{{ section.id }} .sp__material-wrap {
    background: var(--surface-raised);
    border: 1px solid var(--surface-border);
    padding: var(--space-3);
    margin: 0 0 var(--space-3);
  }

  #MainProduct-{{ section.id }} .sp__material-wrap .academy-material-insight {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }

  /* ── Option groups ─────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__option-group {
    margin-bottom: var(--space-2);
  }

  #MainProduct-{{ section.id }} .sp__option-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ghost);
    margin-bottom: var(--space-1);
    display: flex;
    gap: 0.4rem;
  }

  #MainProduct-{{ section.id }} .sp__option-selected {
    color: var(--cream);
  }

  #MainProduct-{{ section.id }} .sp__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  #MainProduct-{{ section.id }} .sp__opt-btn {
    background: var(--surface-raised);
    border: 1.5px solid var(--surface-border);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    transition: border-color var(--duration-micro) var(--ease-luxury),
                color var(--duration-micro) var(--ease-luxury),
                background var(--duration-micro) var(--ease-luxury);
    letter-spacing: 0.04em;
    min-width: 48px;
    text-align: center;
  }

  #MainProduct-{{ section.id }} .sp__opt-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  #MainProduct-{{ section.id }} .sp__opt-btn--active {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-glow);
  }

  #MainProduct-{{ section.id }} .sp__opt-btn--unavailable {
    opacity: 0.3;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* ── Social proof ─────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__social-proof {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0 0 var(--space-3);
  }

  #MainProduct-{{ section.id }} .sp__stars {
    display: flex;
    gap: 2px;
    align-items: center;
  }

  #MainProduct-{{ section.id }} .sp__star {
    fill: var(--ghost);
    flex-shrink: 0;
  }

  #MainProduct-{{ section.id }} .sp__social-text {
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.05em;
    font-weight: var(--weight-regular);
  }

  #MainProduct-{{ section.id }} .sp__review-count {
    color: var(--ghost);
  }

  /* ── Form: quantity + ATC ──────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__form-row {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
    align-items: stretch;
  }

  #MainProduct-{{ section.id }} .sp__qty-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--surface-border);
    background: var(--surface-raised);
    flex-shrink: 0;
    min-height: var(--space-6);
  }

  #MainProduct-{{ section.id }} .sp__qty-btn {
    background: none;
    border: none;
    color: var(--cream);
    font-size: var(--text-lg);
    width: 2.5rem;
    height: 100%;
    cursor: pointer;
    transition: color var(--duration-micro) var(--ease-luxury);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
  }

  #MainProduct-{{ section.id }} .sp__qty-btn:hover { color: var(--muted); }

  #MainProduct-{{ section.id }} .sp__qty-input {
    background: none;
    border: none;
    border-left: 1px solid var(--surface-border);
    border-right: 1px solid var(--surface-border);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-align: center;
    width: 3rem;
    padding: 0.5rem 0;
    outline: none;
    -moz-appearance: textfield;
  }

  #MainProduct-{{ section.id }} .sp__qty-input::-webkit-inner-spin-button,
  #MainProduct-{{ section.id }} .sp__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  #MainProduct-{{ section.id }} .sp__atc-btn {
    flex: 1;
    background: var(--gold);
    color: var(--surface-void);
    border: 2px solid var(--gold);
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    cursor: pointer;
    padding: 0 var(--space-4);
    min-height: var(--space-6);
    transition: background var(--duration-micro) var(--ease-luxury),
                color var(--duration-micro) var(--ease-luxury),
                border-color var(--duration-micro) var(--ease-luxury);
    white-space: nowrap;
  }

  #MainProduct-{{ section.id }} .sp__atc-btn:hover:not(:disabled) {
    background: transparent;
    color: var(--gold);
    border-color: var(--gold);
  }

  #MainProduct-{{ section.id }} .sp__atc-btn:disabled {
    background: var(--surface-raised);
    border-color: var(--surface-border);
    color: var(--ghost);
    cursor: not-allowed;
  }

  #MainProduct-{{ section.id }} .sp__atc-btn--loading {
    opacity: 0.7;
    pointer-events: none;
  }

  /* ── Trust badges ─────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__trust {
    display: flex;
    gap: 0;
    border: 1px solid var(--surface-border);
    margin-top: var(--space-3);
  }

  #MainProduct-{{ section.id }} .sp__trust-badge {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: var(--space-2) var(--space-1);
    border-right: 1px solid var(--surface-border);
    text-align: center;
  }

  #MainProduct-{{ section.id }} .sp__trust-badge:last-child {
    border-right: none;
  }

  #MainProduct-{{ section.id }} .sp__trust-icon {
    color: var(--muted);
    flex-shrink: 0;
  }

  #MainProduct-{{ section.id }} .sp__trust-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #MainProduct-{{ section.id }} .sp__trust-text {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--ghost);
    text-transform: uppercase;
    line-height: var(--leading-snug);
  }

  /* ─────────────────────────────────────────────────────────────────
     DESCRIPTION — Full width, luxury whitespace below the fold
  ───────────────────────────────────────────────────────────────── */
  #MainProduct-{{ section.id }} .sp__desc-section {
    margin-top: var(--space-9);
    border-top: 1px solid var(--surface-border);
    padding: var(--space-6) 0 var(--space-7);
  }

  #MainProduct-{{ section.id }} .sp__desc-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  #MainProduct-{{ section.id }} .sp__desc-heading {
    font-family: 'Playfair Display', serif;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wider);
    color: var(--cream);
    text-transform: uppercase;
    margin: 0;
    line-height: var(--leading-tight);
    white-space: nowrap;
  }

  #MainProduct-{{ section.id }} .sp__desc-line {
    flex: 1;
    height: 1px;
    background: var(--surface-border);
  }

  #MainProduct-{{ section.id }} .sp__desc-body {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    max-width: var(--width-editorial);
    columns: 2;
    column-gap: var(--space-6);
  }

  #MainProduct-{{ section.id }} .sp__desc-body p {
    margin-top: 0;
    break-inside: avoid;
  }

  /* ── Mobile ─────────────────────────────────────────────────────── */
  @media screen and (max-width: 899px) {
    #MainProduct-{{ section.id }} .sp__layout {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    #MainProduct-{{ section.id }} .sp__gallery {
      position: static;
    }

    #MainProduct-{{ section.id }} .sp__desc-body {
      columns: 1;
    }

    #MainProduct-{{ section.id }} .sp__desc-section {
      margin-top: var(--space-7);
    }
  }

  @media screen and (max-width: 479px) {
    #MainProduct-{{ section.id }} {
      padding: var(--space-5) var(--space-2) 0;
    }

    #MainProduct-{{ section.id }} .sp__form-row {
      flex-direction: column;
    }

    #MainProduct-{{ section.id }} .sp__atc-btn {
      padding: 0 var(--space-3);
    }

    #MainProduct-{{ section.id }} .sp__trust {
      flex-direction: column;
    }

    #MainProduct-{{ section.id }} .sp__trust-badge {
      flex-direction: row;
      border-right: none;
      border-bottom: 1px solid var(--surface-border);
      padding: var(--space-2) var(--space-2);
      text-align: left;
      gap: var(--space-1);
    }

    #MainProduct-{{ section.id }} .sp__trust-badge:last-child {
      border-bottom: none;
    }
  }
{%- endstyle -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign first_image = current_variant.featured_image | default: product.featured_image -%}

<section id="MainProduct-{{ section.id }}">
  <div class="sp__inner">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="sp__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">›</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">›</span>
      {%- else -%}
        <a href="{{ routes.collections_url }}">Socks</a>
        <span aria-hidden="true">›</span>
      {%- endif -%}
      <span>{{ product.title }}</span>
    </nav>

    <div class="sp__layout">

      {%- comment -%} ── Gallery ── {%- endcomment -%}
      <div class="sp__gallery">
        <div class="sp__main-img-wrap">
          {%- if first_image -%}
            <img
              id="sp-main-img-{{ section.id }}"
              class="sp__main-img"
              src="{{ first_image | image_url: width: 900 }}"
              alt="{{ first_image.alt | escape | default: product.title }}"
              width="{{ first_image.width }}"
              height="{{ first_image.height }}"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'sp__main-img' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="sp__thumbs">
            {%- for image in product.images limit: 6 -%}
              <button
                type="button"
                class="sp__thumb{% if forloop.first %} sp__thumb--active{% endif %}"
                data-src="{{ image | image_url: width: 900 }}"
                data-index="{{ forloop.index0 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 160 }}"
                  alt="{{ image.alt | escape | default: product.title }}"
                  width="64"
                  height="80"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Product info ── {%- endcomment -%}
      <div class="sp__info">

        {%- if product.vendor != blank -%}
          <p class="sp__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="sp__title">{{ product.title }}</h1>

        {%- comment -%} Price {%- endcomment -%}
        <div class="sp__price-row" id="sp-price-row-{{ section.id }}">
          <span class="sp__price" id="sp-price-{{ section.id }}">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="sp__compare-price" id="sp-compare-{{ section.id }}">
              {{ current_variant.compare_at_price | money }}
            </s>
            <span class="sp__badge-sale">Sale</span>
          {%- else -%}
            <s class="sp__compare-price" id="sp-compare-{{ section.id }}" style="display:none">
              {{ current_variant.compare_at_price | money }}
            </s>
          {%- endif -%}
        </div>

        {%- comment -%} Short description {%- endcomment -%}
        {%- if product.metafields.descriptors.subtitle.value != blank -%}
          <p class="sp__short-desc">{{ product.metafields.descriptors.subtitle.value }}</p>
        {%- elsif product.description != blank -%}
          <p class="sp__short-desc">{{ product.description | strip_html | truncatewords: 28 }}</p>
        {%- endif -%}

        {%- comment -%} Material Insight — authority position (between desc + variants) {%- endcomment -%}
        <div class="sp__material-wrap">
          {% render 'academy-material-insight', product: product %}
        </div>

        {%- comment -%} Variant options {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="sp__option-group">
              <div class="sp__option-label">
                {{ option.name }}:
                <span
                  class="sp__option-selected"
                  id="sp-opt-val-{{ section.id }}-{{ option.position }}"
                >{{ option.selected_value }}</span>
              </div>
              <div class="sp__option-values">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="sp__opt-btn{% if option.selected_value == value %} sp__opt-btn--active{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value | escape }}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {%- comment -%} Social proof — static placeholder; replace with Judge.me widget post-install {%- endcomment -%}
        <div class="sp__social-proof">
          <div class="sp__stars" aria-label="Rated 4.9 out of 5">
            {%- for i in (1..5) -%}
              <svg class="sp__star" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                <polygon points="6,0.5 7.55,4.1 11.5,4.6 8.75,7.25 9.5,11.2 6,9.2 2.5,11.2 3.25,7.25 0.5,4.6 4.45,4.1"/>
              </svg>
            {%- endfor -%}
          </div>
          <span class="sp__social-text">4.9 <span class="sp__review-count">· 127 reviews</span></span>
        </div>

        {%- comment -%} Form: qty + ATC {%- endcomment -%}
        {%- form 'product', product,
          id: 'product-form-{{ section.id }}',
          novalidate: 'novalidate'
        -%}
          <input
            type="hidden"
            name="id"
            id="variant-id-{{ section.id }}"
            value="{{ current_variant.id }}"
          >

          <div class="sp__form-row">
            <div class="sp__qty-wrap">
              <button type="button" class="sp__qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
              <input
                type="number"
                name="quantity"
                id="sp-qty-{{ section.id }}"
                class="sp__qty-input"
                value="1"
                min="1"
                aria-label="Quantity"
              >
              <button type="button" class="sp__qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
            </div>

            <button
              type="submit"
              id="sp-atc-{{ section.id }}"
              class="sp__atc-btn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- comment -%} Trust badges {%- endcomment -%}
        <div class="sp__trust" id="sp-trust-{{ section.id }}">
          <div class="sp__trust-badge">
            <span class="sp__trust-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            <span class="sp__trust-text">Secure<br>Checkout</span>
          </div>
          <div class="sp__trust-badge">
            <span class="sp__trust-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="1 4 1 10 7 10"/>
                <path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
              </svg>
            </span>
            <span class="sp__trust-text">Free<br>Returns</span>
          </div>
          <div class="sp__trust-badge">
            <span class="sp__trust-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
            </span>
            <span class="sp__trust-text">Premium<br>Quality</span>
          </div>
        </div>

      </div>{%- comment -%} /.sp__info {%- endcomment -%}
    </div>{%- comment -%} /.sp__layout {%- endcomment -%}

    {%- comment -%} ── Full-width description ── {%- endcomment -%}
    {%- if product.description != blank -%}
      <div class="sp__desc-section">
        <div class="sp__desc-header">
          <h2 class="sp__desc-heading">Description</h2>
          <span class="sp__desc-line" aria-hidden="true"></span>
        </div>
        <div class="sp__desc-body">
          {{ product.description }}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  'use strict';

  var SID      = '{{ section.id }}';
  var variants = {{ product.variants | json }};

  /* ── Current selected options ── */
  var selectedOpts = {};
  {%- for option in product.options_with_values -%}
    selectedOpts[{{ option.position | json }}] = {{ option.selected_value | json }};
  {%- endfor -%}

  /* ── Helpers ── */
  function findVariant() {
    return variants.find(function (v) {
      return v.options.every(function (opt, i) {
        return selectedOpts[i + 1] === opt;
      });
    });
  }

  function formatMoney(cents) {
    var amount = (cents / 100).toFixed(2);
    return '{{ cart.currency.symbol }}' + amount;
  }

  function applyVariant(v) {
    if (!v) return;

    var idInput = document.getElementById('variant-id-' + SID);
    if (idInput) idInput.value = v.id;

    var priceEl   = document.getElementById('sp-price-' + SID);
    var compareEl = document.getElementById('sp-compare-' + SID);
    if (priceEl)   priceEl.textContent = formatMoney(v.price);
    if (compareEl) {
      if (v.compare_at_price > v.price) {
        compareEl.textContent   = formatMoney(v.compare_at_price);
        compareEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
      }
    }

    var atcBtn = document.getElementById('sp-atc-' + SID);
    if (atcBtn) {
      atcBtn.disabled    = !v.available;
      atcBtn.textContent = v.available ? 'Add to Cart' : 'Sold Out';
    }

    if (v.featured_image) {
      switchMainImage(v.featured_image.src, null);
    }
  }

  /* ── Gallery ── */
  function switchMainImage(src, thumbIndex) {
    var mainImg = document.getElementById('sp-main-img-' + SID);
    if (!mainImg) return;

    mainImg.classList.add('sp--swapping');
    setTimeout(function () {
      mainImg.src = src;
      mainImg.classList.remove('sp--swapping');
    }, 150);

    if (thumbIndex !== null) {
      document.querySelectorAll('#MainProduct-' + SID + ' .sp__thumb').forEach(function (t, i) {
        t.classList.toggle('sp__thumb--active', i === thumbIndex);
      });
    }
  }

  document.querySelectorAll('#MainProduct-' + SID + ' .sp__thumb').forEach(function (thumb, i) {
    thumb.addEventListener('click', function () {
      switchMainImage(thumb.dataset.src, i);
    });
  });

  /* ── Option buttons ── */
  document.querySelectorAll('#MainProduct-' + SID + ' .sp__opt-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pos = parseInt(btn.dataset.optionPosition, 10);
      var val = btn.dataset.optionValue;

      document.querySelectorAll(
        '#MainProduct-' + SID + ' [data-option-position="' + pos + '"]'
      ).forEach(function (b) { b.classList.remove('sp__opt-btn--active'); });
      btn.classList.add('sp__opt-btn--active');

      var labelEl = document.getElementById('sp-opt-val-' + SID + '-' + pos);
      if (labelEl) labelEl.textContent = val;

      selectedOpts[pos] = val;
      applyVariant(findVariant());
    });
  });

  /* ── Quantity ── */
  document.querySelectorAll('#MainProduct-' + SID + ' .sp__qty-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = document.getElementById('sp-qty-' + SID);
      if (!input) return;
      var v = parseInt(input.value, 10) || 1;
      if (btn.dataset.action === 'increase') {
        input.value = v + 1;
      } else if (btn.dataset.action === 'decrease' && v > 1) {
        input.value = v - 1;
      }
    });
  });

  /* ── ATC loading state ── */
  var form = document.getElementById('product-form-' + SID);
  if (form) {
    form.addEventListener('submit', function () {
      var atc = document.getElementById('sp-atc-' + SID);
      if (atc) atc.classList.add('sp__atc-btn--loading');
    });
  }

  /* ── Material Insight reveal (IntersectionObserver) ── */
  var insightEl = document.querySelector('#MainProduct-' + SID + ' [data-academy-insight]');
  if (insightEl) {
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 }).observe(insightEl);
    } else {
      insightEl.classList.add('is-visible');
    }
  }

})();
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
