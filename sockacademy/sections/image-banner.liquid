<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @keyframes sa-fade-up {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #Banner-{{ section.id }} {
    background: linear-gradient(180deg, #111111 0%, #1A1A1A 60%, #1A1A1A 100%);
    background-color: #1A1A1A;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 6.25rem 2rem;
    clip-path: polygon(0 0, 100% 0, 100% 93%, 0 100%);
    margin-bottom: -7vh;
    z-index: 2;
  }

  #Banner-{{ section.id }} .banner__media {
    position: absolute;
    inset: 0;
  }

  #Banner-{{ section.id }} .banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  #Banner-{{ section.id }} .banner__hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    width: 100%;
  }

  #Banner-{{ section.id }} .banner__hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: #F0EDE6;
    text-transform: uppercase;
    margin: 0 0 1rem;
    animation: sa-fade-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  #Banner-{{ section.id }} .banner__hero-subtitle {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: #C9A84C;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 3rem;
    animation: sa-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
  }

  #Banner-{{ section.id }} .banner__hero-buttons {
    animation: sa-fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.4s both;
  }

  #Banner-{{ section.id }} .banner__hero-btn {
    display: inline-block;
    background: #C9A84C;
    color: #1A1A1A;
    padding: 1rem 3rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid #C9A84C;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }

  #Banner-{{ section.id }} .banner__hero-btn:hover,
  #Banner-{{ section.id }} .banner__hero-btn:focus-visible {
    background: #E2C47A;
    border-color: #E2C47A;
    color: #1A1A1A;
  }

  #Banner-{{ section.id }} .banner__3d-sphere {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    width: 35%;
    min-width: 180px;
    max-width: 420px;
    aspect-ratio: 1/1;
    pointer-events: none;
    z-index: 3;
  }

  @media screen and (max-width: 768px) {
    #Banner-{{ section.id }} {
      padding: 2.5rem 1.25rem;
      min-height: 80vh;
    }

    #Banner-{{ section.id }} .banner__hero-subtitle {
      font-size: clamp(0.75rem, 3vw, 1rem);
      letter-spacing: 0.12em;
      margin-bottom: 2rem;
    }

    #Banner-{{ section.id }} .banner__hero-btn {
      padding: 0.85rem 2rem;
      font-size: 0.875rem;
    }
  }

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__3d-sphere {
      display: none;
    }
  }

{%- endstyle -%}

<div id="Banner-{{ section.id }}" class="banner">
  {%- if section.settings.image != blank -%}
    <div class="banner__media">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <div class="banner__3d-sphere sock-3d-banner"></div>

  <div class="banner__hero-content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h1 class="banner__hero-title" {{ block.shopify_attributes }}>
            {{- block.settings.heading | escape -}}
          </h1>
        {%- when 'text' -%}
          <p class="banner__hero-subtitle" {{ block.shopify_attributes }}>
            {{- block.settings.text | escape -}}
          </p>
        {%- when 'buttons' -%}
          <div class="banner__hero-buttons" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label_1 != blank -%}
              <a
                {% if block.settings.button_link_1 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link_1 }}"
                {% endif %}
                class="banner__hero-btn"
              >
                {{- block.settings.button_label_1 | escape -}}
              </a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              <a
                {% if block.settings.button_link_2 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link_2 }}"
                {% endif %}
                class="banner__hero-btn"
                style="margin-left: 1rem;"
              >
                {{- block.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'sockacademy-3d.js' | asset_url }}" defer="defer"></script>

