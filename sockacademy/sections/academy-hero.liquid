{%- style -%}
  /* ── SockAcademy Academy Hero — Editorial Mode ── */

  @keyframes kenburns-slow {
    0%   { transform: scale(1.0) translate(0, 0); }
    100% { transform: scale(1.08) translate(-1.5%, -1%); }
  }

  /* Pull section flush behind transparent header */
  .shopify-section:has(> .ac-hero) {
    margin-top: -76px;
    transform: none !important;
  }

  .ac-hero {
    position: relative;
    min-height: 100dvh;
    background-color: var(--surface-void);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  /* ── Layer 0: Ken Burns image ─────────────────────────── */
  .ac-hero__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ac-hero__canvas img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.5;
    will-change: transform;
    animation-name: kenburns-slow;
    animation-duration: var(--duration-cinematic);
    animation-timing-function: var(--ease-luxury);
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-hero__canvas img {
      animation: none;
      will-change: auto;
    }
  }

  /* ── Layer 1: Gradient veil — transparent → near-black ── */
  .ac-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(13, 13, 13, 0)    0%,
      rgba(13, 13, 13, 0.45) 40%,
      rgba(13, 13, 13, 0.92) 100%
    );
  }

  /* ── Layer 2: Editorial content — bottom-left ─────────── */
  .ac-hero__stage {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-10);
  }

  .ac-hero__eyebrow {
    display: block;
    font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  /* Two-line headline: voice (italic) + anchor (upright) */
  .ac-hero__headline {
    display: flex;
    flex-direction: column;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-6);
    max-width: 12ch;
  }

  .ac-hero__headline--voice {
    font-style: italic;
    font-weight: var(--weight-bold);
    color: var(--cream);
  }

  .ac-hero__headline--anchor {
    font-style: normal;
    font-weight: var(--weight-regular);
    color: var(--cream);
  }

  /* Single gold element — Gold Discipline: 1/1 */
  .ac-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 var(--space-5);
    background-color: var(--gold);
    color: var(--surface-base);
    font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--gold);
    border-radius: var(--radius-sm);
    transition:
      background  var(--duration-micro) var(--ease-luxury),
      color       var(--duration-micro) var(--ease-luxury),
      transform   var(--duration-micro) var(--ease-luxury);
    white-space: nowrap;
  }

  .ac-hero__cta:hover {
    background-color: transparent;
    color: var(--gold);
    transform: translateY(-2px);
  }

  /* ── Layer 3: Gold-dim separator at bottom edge ────────── */
  .ac-hero__rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gold-dim);
    z-index: 3;
  }

  /* ── Mobile ────────────────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .ac-hero {
      min-height: 90dvh;
    }

    .ac-hero__stage {
      padding: 0 var(--space-3) var(--space-8);
    }

    .ac-hero__headline {
      font-size: clamp(3rem, 12vw, 4.5rem);
      max-width: 100%;
    }

    .ac-hero__cta {
      width: 100%;
      justify-content: center;
    }
  }

  /* ── Tablet ─────────────────────────────────────────────── */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ac-hero__stage {
      padding: 0 var(--space-5) var(--space-9);
    }

    .ac-hero__headline {
      font-size: clamp(3.5rem, 8vw, 6rem);
    }
  }
{%- endstyle -%}

<section class="ac-hero" aria-label="{{ section.settings.heading_voice | escape }} {{ section.settings.heading_anchor | escape }}">

  {%- if section.settings.image != blank -%}
    <div class="ac-hero__canvas" aria-hidden="true">
      {{- section.settings.image | image_url: width: 2000 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          alt: section.settings.image.alt | default: section.settings.heading_voice -}}
    </div>
  {%- else -%}
    <div class="ac-hero__canvas" aria-hidden="true">
      <img
        src="{{ 'sa-hero-banner.png' | asset_url }}"
        alt="{{ section.settings.heading_voice | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1536"
        height="1024"
      >
    </div>
  {%- endif -%}

  <div class="ac-hero__veil" aria-hidden="true"></div>

  <div class="ac-hero__stage">
    {%- if section.settings.eyebrow != blank -%}
      <span class="ac-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="ac-hero__headline">
      {%- if section.settings.heading_voice != blank -%}
        <span class="ac-hero__headline--voice">{{ section.settings.heading_voice }}</span>
      {%- endif -%}
      {%- if section.settings.heading_anchor != blank -%}
        <span class="ac-hero__headline--anchor">{{ section.settings.heading_anchor }}</span>
      {%- endif -%}
    </h1>

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="ac-hero__cta">
        {{- section.settings.cta_label -}}
      </a>
    {%- endif -%}
  </div>

  <div class="ac-hero__rule" aria-hidden="true"></div>

</section>

{% schema %}
{
  "name": "AC Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The World's Sock Specialists"
    },
    {
      "type": "text",
      "id": "heading_voice",
      "label": "Headline — Voice (italic, bold)",
      "default": "Wear Something"
    },
    {
      "type": "text",
      "id": "heading_anchor",
      "label": "Headline — Anchor (upright, light)",
      "default": "Worth Noticing"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "AC Hero"
    }
  ]
}
{% endschema %}
