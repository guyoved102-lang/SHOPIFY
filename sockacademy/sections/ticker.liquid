{%- style -%}
  #Ticker-{{ section.id }} {
    background: #1A1A1A;
    border-top: 1px solid rgba(201, 168, 76, 0.15);
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  @keyframes sa-ticker-{{ section.id }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  #Ticker-{{ section.id }} .tk__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: sa-ticker-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  #Ticker-{{ section.id }}:hover .tk__track {
    animation-play-state: paused;
  }

  #Ticker-{{ section.id }} .tk__item {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C9A84C;
    white-space: nowrap;
    padding: 0.85rem 2rem;
    display: inline-block;
  }

  #Ticker-{{ section.id }} .tk__sep {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(201, 168, 76, 0.45);
    vertical-align: middle;
    flex-shrink: 0;
  }
{%- endstyle -%}

{%- assign items = section.settings.text | split: ' · ' -%}

<div id="Ticker-{{ section.id }}" aria-hidden="true" role="marquee">
  <div class="tk__track">
    {%- for run in (1..2) -%}
      {%- for item in items -%}
        {%- unless item == blank -%}
          <span class="tk__item">{{ item | strip }}</span>
          <span class="tk__sep"></span>
        {%- endunless -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ticker Strip",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Ticker items (separate with ·)",
      "default": "PREMIUM QUALITY · FREE SHIPPING OVER $50 · THE WORLD'S FIRST SOCK AUTHORITY · MERINO WOOL · COOLMAX TECHNOLOGY · GIFT SETS AVAILABLE"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds — higher is slower)",
      "min": 15,
      "max": 80,
      "step": 5,
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "Ticker Strip"
    }
  ]
}
{% endschema %}
