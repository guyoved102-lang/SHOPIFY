{%- comment -%}
  main-collection-product-grid.liquid — Curatorial Mode
  Academy 3-column grid. Filters hidden (Phase 3 — curated catalog).
  Card: academy-card-product.liquid | Image: 3:4 | No ATC.
  All styles in sockacademy.css (loaded globally via theme.liquid).
{%- endcomment -%}

<div class="ac-grid" id="MainCollectionGrid-{{ section.id }}">
  {%- paginate collection.products by section.settings.products_per_page -%}

    {%- if collection.products.size == 0 -%}
      <div class="ac-grid__empty" id="product-grid" data-id="{{ section.id }}">
        {{ 'sections.collection_template.empty' | t }}
      </div>
    {%- else -%}
      <ul class="ac-grid__list" id="product-grid" data-id="{{ section.id }}">
        {%- for product in collection.products -%}
          <li class="ac-grid__item">
            {%- render 'academy-card-product',
              card_product: product,
              lazy_load: forloop.index > 3
            -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate, anchor: '' -%}
      {%- endif -%}
    {%- endif -%}

  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Academy Collection Grid",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 9,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
